{
  "name": "@prompt-optimizer/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "regression:after": "node --experimental-strip-types --loader ./scripts/ts-extension-loader.mjs ./scripts/after-review-regression.ts",
    "test:deep-analysis-v2": "node ./scripts/deep-analysis-v2-smoke.mjs",
    "test:deep-analysis-v2-eval": "node ./scripts/deep-analysis-v2-eval.mjs",
    "test:deep-analysis-v2:ci": "npm run test:deep-analysis-v2 && npm run test:deep-analysis-v2-eval",
    "health:deep-analysis-v2": "node ./scripts/deep-analysis-v2-health.mjs",
    "report:deep-analysis-v2-live": "node ./scripts/deep-analysis-v2-live-report.mjs",
    "generate:deep-analysis-v2-silver": "node ./scripts/deep-analysis-v2-silver-eval-generate.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@prompt-optimizer/shared": "0.1.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "25.5.2",
    "@types/react": "19.2.14",
    "prisma": "^5.20.0",
    "typescript": "^5.6.2"
  }
}
